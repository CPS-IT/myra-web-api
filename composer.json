{
    "name": "cpsit/myra-web-api",
    "description": "PHP client for the Myra Cloud Web API v1 and v2",
    "keywords": [
        "myracloud",
        "myra",
        "api",
        "cdn"
    ],
    "homepage": "https://github.com/CPS-IT/myra-web-api",
    "type": "library",
    "license": "MIT",
    "minimum-stability": "stable",
    "require": {
        "php": "^8.2",
        "guzzlehttp/guzzle": "^7.8 || ^8.0",
        "guzzlehttp/psr7": "^2.5.1 || ^3.1",
        "psr/clock": "^1.0",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.1",
        "psr/http-message": "^1.1 || ^2.0"
    },
    "autoload": {
        "psr-4": {
            "Myracloud\\WebApi\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Myracloud\\WebApi\\Tests\\": "tests/"
        }
    },
    "config": {
        "platform": {
            "php": "8.2.0"
        },
        "sort-packages": true,
        "allow-plugins": {
            "infection/extension-installer": true,
            "phpstan/extension-installer": true
        }
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "infection/infection": "^0.32.6",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.3",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-phpunit": "^2.1",
        "phpstan/phpstan-strict-rules": "^2.1",
        "phpunit/phpunit": "^11",
        "shipmonk/composer-dependency-analyser": "^1.8"
    },
    "scripts": {
        "lint": "find src tests -name '*.php' -print0 | xargs -0 -n1 php -l > /dev/null",
        "cs": "php-cs-fixer check --diff",
        "cs:fix": "php-cs-fixer fix",
        "stan": "phpstan analyse --no-progress",
        "deps": "composer-dependency-analyser",
        "test": "phpunit",
        "infection": "XDEBUG_MODE=coverage infection --threads=max --show-mutations",
        "ci": [
            "@composer validate --strict",
            "@lint",
            "@cs",
            "@stan",
            "@deps",
            "@test"
        ]
    },
    "scripts-descriptions": {
        "infection": "Mutation testing on Auth/Http/Exception (needs a coverage driver: `ddev xdebug on`)",
        "ci": "All gates except mutation testing"
    }
}
